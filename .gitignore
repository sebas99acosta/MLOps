# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Modelos entrenados dinámicamente (volumen compartido jupyter <-> api).
# Son artefactos generados en tiempo de ejecución, no código fuente: si se
# versionan, cada clon del repo arranca con modelos "de fábrica" en vez de
# vacío, lo que rompe la demo de auto-detección con watchdog.
Nivel_1/Taller_contenedores/models/*
!Nivel_1/Taller_contenedores/models/.gitkeep

# Mismo motivo para Taller_Airflow: modelos entrenados por el DAG y logs de
# Airflow son artefactos de ejecución, no código fuente.
Nivel_2/Taller_Airflow/models/*
!Nivel_2/Taller_Airflow/models/.gitkeep
Nivel_2/Taller_Airflow/logs/*
!Nivel_2/Taller_Airflow/logs/.gitkeep

# .env contiene credenciales (aunque sean de demo) — no se versiona; se
# provee .env.example como plantilla.
Nivel_2/Taller_Airflow/.env

# Proyecto I: el dataset (32 MB, del repo del profesor) y el estado que el
# data API local escribe en tiempo de ejecución no se versionan.
proyectos/proyecto_I/data_api/data/*

# .env con credenciales: no se versiona, se provee .env.example.
proyectos/proyecto_I/.env

# Logs de Airflow de Proyecto I: artefactos de ejecución.
proyectos/proyecto_I/logs/*
!proyectos/proyecto_I/logs/.gitkeep

# Registro interno de decisiones de diseño: no se publica.
proyectos/proyecto_I/DECISIONS.md
