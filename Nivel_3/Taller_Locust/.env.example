# Copy to .env (cp .env.example .env).
# The MLflow and MinIO credentials MUST match Nivel_2/Taller_MLflow/.env:
# this stack reuses that workshop's volumes (registered models included).

MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow
MLFLOW_DB_NAME=mlflow

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MLFLOW_BUCKET=mlflow

# Limits applied to EACH API replica (the workshop fixes 1 CPU and 1 GB).
API_CPUS=1.0
API_MEMORY=1g
