# Template for the Secret `mlops-secrets`. Copy to secrets.env (gitignored),
# change every value, then on the VM:
#
#   kubectl create namespace mlops
#   kubectl -n mlops create secret generic mlops-secrets --from-env-file=secrets.env
#
# Use letters and digits only: some values are embedded in URLs
# (postgresql://user:password@host, http://user:password@minio), where
# characters like @ : / # break the URL.

# Postgres superuser (only used to create the databases and roles).
POSTGRES_PASSWORD=changemepostgres

# Application roles, one per database.
DIABETES_DB_PASSWORD=changemediabetes
MLFLOW_DB_PASSWORD=changememlflow
AIRFLOW_DB_PASSWORD=changemeairflow

# MinIO root user: MLflow's artifact store.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changememinio123
