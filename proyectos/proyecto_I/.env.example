# Copia este archivo a .env:  cp .env.example .env
# En la VM (Linux), ajusta AIRFLOW_UID con:
#   sed -i "s/^AIRFLOW_UID=.*/AIRFLOW_UID=$(id -u)/" .env

# Postgres de DATOS (etapas raw / processed / training).
DATA_DB_USER=covertype
DATA_DB_PASSWORD=covertype
DATA_DB_NAME=covertype

# Postgres de METADATOS de Airflow (corridas, estados, usuarios).
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# Usuario de la UI de Airflow.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# UID con el que corren los contenedores de Airflow (ver comando arriba).
AIRFLOW_UID=50000

# MinIO (almacenamiento de modelos). La contraseña debe tener 8+ caracteres.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=models

# Token de acceso a JupyterLab. Cámbialo en la VM: queda expuesto en la red.
JUPYTER_TOKEN=change-me-covertype

# Data API que consume el DAG:
#   pruebas locales:  http://data-api:80           (requiere --profile local-data-api)
#   entrega real:     http://10.43.97.110:8080
DATA_API_URL=http://data-api:80

# Data API local de pruebas: segundos entre cambios de batch (el real usa 300).
MIN_UPDATE_TIME=30
