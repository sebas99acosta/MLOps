# Copia este archivo a .env y ajusta lo necesario:
#   cp .env.example .env
#
# En Linux, reemplaza AIRFLOW_UID por el resultado real de `id -u` — ver
# el README para más detalle de por qué importa.

# Postgres — metadatos internos de Airflow (DAG runs, task states, usuarios).
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# MySQL — datos de penguins (separado del metastore de Airflow).
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=penguins
MYSQL_USER=penguins_user
MYSQL_PASSWORD=penguins_pass

# UID con el que corren los contenedores de Airflow. En Linux, reemplaza este
# valor por el resultado de `id -u` en la VM — si no coincide con tu usuario,
# los archivos que Airflow escribe en ./dags, ./logs quedan con dueño
# equivocado y no podrás editarlos/borrarlos sin sudo.
AIRFLOW_UID=50000
