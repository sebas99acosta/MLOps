# Copy to .env (cp .env.example .env) and change the passwords if you want.

# Data database: raw and processed covertype data.
DATA_DB_USER=covertype
DATA_DB_PASSWORD=covertype
DATA_DB_NAME=covertype

# MLflow's own metadata database: experiments, runs, params, metrics, registry.
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow
MLFLOW_DB_NAME=mlflow

# MinIO: artifact store for MLflow. Only the MLflow server uses these.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MLFLOW_BUCKET=mlflow

# Your user ID on the host (run `id -u`), so files Jupyter saves are yours.
HOST_UID=1000

JUPYTER_TOKEN=change-me-mlflow
